# ============================================================
# ActionHub - Configuration Environment Variables
# ============================================================

# ------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------

# URL publique de votre projet Supabase
# Get these values from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url

# Clé publique (anon key) - Safe to use in browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Clé service role - CRITICAL: Never expose client-side!
# Used only in middleware and server actions
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Note: The anon key is safe to use in the browser.
# Row Level Security (RLS) policies protect your data.

# ------------------------------------------------------------
# Google Drive OAuth 2.0 (Phase 2)
# ------------------------------------------------------------

# Client ID OAuth 2.0 from Google Cloud Console
# Format: xxxxx.apps.googleusercontent.com
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

# Client Secret OAuth 2.0 from Google Cloud Console
# ⚠️ IMPORTANT: Never commit this value!
GOOGLE_CLIENT_SECRET=your_client_secret_here

# Base URL of your application (for OAuth redirects)
# Development: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ------------------------------------------------------------
# Resend Email Service (Phase 4)
# ------------------------------------------------------------

# Resend API Key for transactional emails
# Get from: https://resend.com/api-keys
# ⚠️ IMPORTANT: Never commit this value!
RESEND_API_KEY=re_your_api_key_here

# ------------------------------------------------------------
# Cron Job Security (Phase 2)
# ------------------------------------------------------------

# Secret token to protect sync endpoint
# Generate with: openssl rand -hex 32
# Used in header: Authorization: Bearer {CRON_SECRET}
CRON_SECRET=your_random_secret_here

# ============================================================
# Google Cloud Console Setup Instructions
# ============================================================
#
# 1. Create project: https://console.cloud.google.com/
# 2. Enable Google Drive API
# 3. Configure OAuth consent screen:
#    - User Type: External (or Internal if Google Workspace)
#    - App name: ActionHub
#    - Required scopes:
#      • https://www.googleapis.com/auth/drive.readonly
#      • https://www.googleapis.com/auth/drive.metadata.readonly
#      • https://www.googleapis.com/auth/userinfo.email
# 4. Create OAuth 2.0 Client ID:
#    - Type: Web application
#    - Authorized redirect URIs:
#      • http://localhost:3000/api/auth/google/callback (dev)
#      • https://your-domain.com/api/auth/google/callback (prod)
# 5. Copy Client ID and Client Secret to this file
#
# ============================================================
