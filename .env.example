# ============================================
# ActionHub - Variables d'environnement
# ============================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Google OAuth (pour Google Drive)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Base URL de l'application
NEXT_PUBLIC_BASE_URL=http://localhost:3000  # Production: https://yourdomain.com

# Cron secret (pour sécuriser les endpoints cron)
CRON_SECRET=your_random_secret_here  # Générer avec: openssl rand -hex 32

# Resend API (pour l'envoi d'emails)
# Obtenir une clé API sur https://resend.com
RESEND_API_KEY=re_your_resend_api_key  # Optionnel - si non configuré, les emails seront loggés en console

# ============================================
# Notes d'installation
# ============================================
#
# 1. Copier ce fichier en .env.local
# 2. Remplir les valeurs manquantes
# 3. Ne jamais committer .env.local (déjà dans .gitignore)
#
# Pour générer CRON_SECRET:
#   openssl rand -hex 32
#
# Pour obtenir RESEND_API_KEY:
#   1. Créer un compte sur https://resend.com
#   2. Vérifier un domaine ou utiliser le sandbox
#   3. Générer une API key dans Settings > API Keys
#
